# --- Required ---
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email + list (Resend) ---
RESEND_API_KEY=
# Must be on a domain you've verified in Resend
RESEND_FROM_EMAIL=reports@yourdomain.com
RESEND_FROM_NAME=Unhired
# Optional: assessment leads are added to this segment
RESEND_SEGMENT_ID=
# Optional: leads are opted in to this topic (newsletter subscription management)
RESEND_TOPIC_ID=

# --- Bot protection ---
# Proof-of-work is built in and needs no keys. These are only for switching to
# Cloudflare Turnstile instead (requires a Cloudflare account).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional ---
# Signs the short-lived assessment session cookie. Any long random string.
# If blank, a key is derived from ANTHROPIC_API_KEY.
SESSION_SECRET=

# Dev only: canned AI responses so you can click through without an API key. Ignored in production.
ASSESSMENT_MOCK=
